# Production environment variables (DO NOT commit real credentials)
NODE_ENV=production
PORT=4000
HOST=0.0.0.0
# Use a secure DATABASE_URL for production (set via CI/CD or hosting provider)
DATABASE_URL=postgres://<PROD_DB_USER>:<PROD_DB_PASSWORD>@<PROD_DB_HOST>:5432/<PROD_DB_NAME>
LOG_LEVEL=info
CORS_ORIGIN=https://your-production-domain.example.com
