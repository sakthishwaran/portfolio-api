{
  "name": "portfolio-api",
  "version": "1.0.0",
  "description": "Enterprise-grade Hapi.js backend for the Portfolio application.",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "bunx tsc --noEmit",
    "dev": "bun run --watch app/src/index.ts",
    "start": "bun run app/src/index.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "db:generate": "drizzle-kit generate --config lib/drizzle/drizzle.config.ts",
    "db:migrate": "drizzle-kit migrate --config lib/drizzle/drizzle.config.ts",
    "db:push": "drizzle-kit push --config lib/drizzle/drizzle.config.ts",
    "db:studio": "drizzle-kit studio --config lib/drizzle/drizzle.config.ts",
    "db:seed": "bun run lib/drizzle/seed/seed.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bun": "latest",
    "@types/node": "^26.2.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.9.6",
    "typescript": "5.7.3",
    "typescript-eslint": "^8.65.0"
  },
  "dependencies": {
    "@hapi/boom": "^10.0.1",
    "@hapi/hapi": "^21.4.10",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "pino": "^10.3.1",
    "postgres": "^3.4.9",
    "zod": "^4.4.3"
  },
  "main": "api/index.ts"
}
